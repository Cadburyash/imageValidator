datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Image {
  id            String   @id @default(uuid())
  originalFilename String
  storageKey      String
  mimeType        String
  sizeBytes       Int
  width           Int?
  height          Int?
  perceptualHash String?
  status          Status
  rejectionReasons Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum Status {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  ACCEPTED
  REJECTED
  FAILED
}

